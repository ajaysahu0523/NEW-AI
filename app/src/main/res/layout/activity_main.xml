<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_jarvis_gradient">

    <!-- Top JARVIS HUD Bar -->
    <LinearLayout
        android:id="@+id/top_hud_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/app_name"
                android:textColor="@color/subh_accent_cyan"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_voice_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Female Voice • Hindi &amp; English"
                android:textColor="@color/subh_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_convo_mode"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:checkable="true"
            android:checked="true"
            android:text="2-Way"
            android:textColor="@color/subh_text_primary"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/subh_surface_elevated"
            app:chipStrokeColor="@color/subh_border_glow"
            app:chipStrokeWidth="1dp" />

        <ImageButton
            android:id="@+id/btn_memories"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_memories"
            android:padding="12dp"
            android:src="@drawable/ic_memory"
            app:tint="@color/subh_accent_cyan" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/subh_accent_cyan" />
    </LinearLayout>

    <!-- Holographic Orb + Waveform Centerpiece Card -->
    <LinearLayout
        android:id="@+id/hud_orb_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_hud_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_hud_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.ui.JarvisOrbView
                android:id="@+id/jarvis_orb"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/cd_orb" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_assistant_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/state_idle"
                    android:textColor="@color/subh_accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.example.ui.WaveformView
                    android:id="@+id/waveform_view"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_live_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Tap the glowing mic and speak in Hindi or English."
                    android:textColor="@color/subh_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Female Voice Test & Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_test_voice"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Test Female Voice"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_voice_controls"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Voice Controls"
                android:textColor="@color/subh_accent_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Voice Warning Banner (shown when suitable female voice is unavailable) -->
        <TextView
            android:id="@+id/tv_voice_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bubble_system"
            android:padding="10dp"
            android:textColor="@color/subh_status_error"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quick Action Chips -->
    <HorizontalScrollView
        android:id="@+id/quick_actions_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hud_orb_card">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_quick_time"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quick_time"
                android:textColor="@color/subh_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_quick_calc"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quick_calc"
                android:textColor="@color/subh_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_quick_youtube"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quick_youtube"
                android:textColor="@color/subh_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_quick_camera"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quick_camera"
                android:textColor="@color/subh_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_quick_google"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip_hud"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/quick_google"
                android:textColor="@color/subh_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Conversation RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_confirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quick_actions_scroll" />

    <!-- Sensitive Action Confirmation Card -->
    <LinearLayout
        android:id="@+id/layout_confirmation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_hud_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_action_title"
            android:textColor="@color/subh_accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_confirm_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/subh_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_no"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="@string/confirm_no"
                android:textColor="@color/subh_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_yes"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/confirm_yes" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Input & Glowing Microphone Dock -->
    <LinearLayout
        android:id="@+id/bottom_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/subh_surface_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:hint="@string/hint_type_message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/subh_text_primary"
            android:textColorHint="@color/subh_text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_send_message"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            app:tint="@color/subh_accent_cyan" />

        <ImageButton
            android:id="@+id/btn_stop_speaking"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_stop_speaking"
            android:padding="12dp"
            android:src="@drawable/ic_stop"
            android:visibility="gone"
            app:tint="@color/subh_status_error" />

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_mic_glow"
            android:contentDescription="@string/cd_mic_button"
            android:elevation="6dp"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic"
            app:tint="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
